{
  "layer": "top",
  "position": "top",
  "output": "eDP-1",
  "modules-left": [
    "group/power",
    "group/stats",
    "clock"
  ],
  "modules-center": [
    "sway/workspaces"
  ],
  "modules-right": [
    "custom/notification",
    "sway/mode",
    "pulseaudio",
    "group/networkstatus",
    "battery"
  ],
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "sway/workspaces": {
    "format": "{name}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": " Disconnected",
    "on-click": "nm-connection-editor",
    "on-click-right": "alacritty -e nmtui",
    "tooltip": false
  },
  "custom/mullvad": {
    "exec": "mullvad status --json | jq -c 'select(.state==\"connected\") | { text: .details.location.country }'",
    "return-type": "json",
    "format": "󰕥 {text}",
    "interval": 5,
    "hide-empty-text": true
  },
  "custom/tailscale": {
    "exec": "tailscale status --json | jq -c 'select(.BackendState==\"Running\") | { text: \"󰀑\" }'",
    "return-type": "json",
    "format": "{text}",
    "interval": 5,
    "hide-empty-text": true
  },
  "group/networkstatus": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "custom/mullvad",
      "custom/tailscale"
    ]
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "group/power": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "children-class": "powerchild"
    },
    "modules": [
      "custom/powerbutton",
      "custom/sleepbutton",
      "custom/lockbutton",
      "custom/rebootbutton"
    ]
  },
  "custom/lockbutton": {
    "format": "󰍁",
    "tooltip": false,
    "on-click": "swaylock"
  },
  "custom/rebootbutton": {
    "format": "󰜉",
    "tooltip": false,
    "on-click": "systemctl reboot"
  },
  "custom/powerbutton": {
    "format": "󰤆",
    "tooltip": false,
    "on-click": "systemctl poweroff"
  },
  "custom/sleepbutton": {
    "format": "󰤄",
    "tooltip": false,
    "on-click": "systemctl suspend"
  },
  "clock": {
    "format": "󰥔 {:%I:%M %p 󰸘 %F}"
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "disk",
      "temperature"
    ]
  },
  "cpu": {
    "interval": 10,
    "format": " {}%",
    "max-length": 10
  },
  "disk": {
    "interval": 30,
    "format": "󰋊 {specific_free:0.1f}GB",
    "unit": "GB"
  },
  "temperature": {
    "format": " {temperatureC}°C",
    "critical-threshold": 80
  }
}
